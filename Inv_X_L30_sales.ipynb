import os
import json
import gspread
import pandas as pd
from google.oauth2.service_account import Credentials

# 1. Define required API permissions
SCOPES = [
    'https://www.googleapis.com/auth/spreadsheets',
    'https://www.googleapis.com/auth/drive'
]

# 2. Dynamic Authentication (GitHub Actions vs Colab)
if 'GCP_SA_KEY' in os.environ:
    print("Detected GitHub Actions environment. Authenticating via Service Account...")
    service_account_info = json.loads(os.environ['GCP_SA_KEY'])
    creds = Credentials.from_service_account_info(service_account_info, scopes=SCOPES)
    gc = gspread.authorize(creds)
    print("Successfully authenticated via Service Account!")
else:
    print("Detected Google Colab environment. Authenticating via Interactive Login...")
    from google.colab import auth
    from google.auth import default
    
    auth.authenticate_user()
    creds, _ = default()
    gc = gspread.authorize(creds)
    print("Successfully authenticated via Interactive Colab Login!")

# 3. Access Google Sheet and specific Tab
SPREADSHEET_ID = '1fuPsAOQYF3AHqGSm2nB84NKWyoTkms8FHz1O6eymOwE'
TAB_NAME = 'Inv X L30 sales'

# Open the Google Sheet by ID
sh = gc.open_by_key(SPREADSHEET_ID)

# Select the worksheet tab
worksheet = sh.worksheet(TAB_NAME)

# Read all data into a pandas DataFrame
records = worksheet.get_all_records()
df = pd.DataFrame(records)

print(f"Successfully loaded {len(df)} rows from worksheet '{TAB_NAME}'.")
print(df.head())
